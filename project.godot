; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crosslight"
run/main_scene="uid://e6nmo4emjs3e"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/3d_panning_strength=1.0

[autoload]

WorldState="*res://autoload/world_state.gd"
ZoneManager="*res://autoload/zone_manager.gd"
Settings="*res://autoload/settings.gd"
InputDevice="*res://autoload/input_device.gd"
GamepadCursor="*res://autoload/gamepad_cursor.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[global_group]

living_room=""
hall=""
estate=""
dining_room=""
music_room=""
kitchen=""
storage_room=""
card_room=""

[gui]

theme/custom_font="res://assets/fonts/CormorantGaramond-Variable.ttf"

